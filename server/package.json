{
	"name": "seventh-card-server",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"cf-typegen": "wrangler types",
		"test:sim": "vitest run --project engine test/engine/simulation.test.ts",
		"test:sim:long": "SIM_GAMES=10000 vitest run --project engine test/engine/simulation.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.3",
		"@types/node": "^26.6.6",
		"prettier": "^3.9.10",
		"typescript": "^5.5.2",
		"vitest": "~5.0.3",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"partyserver": "^0.5.10",
		"zod": "^4.6.7"
	}
}
